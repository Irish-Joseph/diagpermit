{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection-report-0.1.json",
  "title": "CollectionReport",
  "description": "The full outcome of the collection phase (protocol 0.1).",
  "type": "object",
  "required": [
    "protocolVersion",
    "requestId",
    "startedAt",
    "completedAt",
    "networkAccess",
    "shellExecution",
    "results"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "networkAccess": {
      "type": "boolean"
    },
    "shellExecution": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "collector-result-0.1.json"
      }
    }
  },
  "additionalProperties": false
}
