{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consent-decision-0.1.json",
  "title": "ConsentDecision",
  "description": "The recorded outcome of the user's consent review (protocol 0.1).",
  "type": "object",
  "required": [
    "protocolVersion",
    "requestId",
    "decidedAt",
    "mode",
    "decisions"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "interactive",
        "assumed",
        "file",
        "plan-preview"
      ]
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "approved",
              "denied"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
