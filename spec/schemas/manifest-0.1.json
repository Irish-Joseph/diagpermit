{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-0.1.json",
  "title": "Manifest",
  "description": "The integrity manifest of a diagnostic artifact. It records every file in the artifact (protocol 0.1).",
  "type": "object",
  "required": [
    "protocolVersion",
    "requestId",
    "generatedAt",
    "totalBytes",
    "entries"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "mediaType",
          "size",
          "sha256",
          "collector",
          "collectorVersion",
          "transformed",
          "truncated"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "collector": {
            "type": "string",
            "minLength": 1
          },
          "collectorVersion": {
            "type": "string",
            "minLength": 1
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "transformed": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
