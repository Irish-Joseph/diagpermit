{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-0.1.json",
  "title": "Finding",
  "description": "A deterministic, evidence-backed observation. Findings are NOT vulnerability claims unless they truly represent one (protocol 0.1).",
  "type": "object",
  "required": [
    "id",
    "severity",
    "summary",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
